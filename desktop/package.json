{
  "name": "verttrade-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "VertTrade private desktop application",
  "author": "spreamming",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "build:sidecar": "bash ../scripts/build_backend_sidecar.sh",
    "start:poc": "npm run build:frontend && electron .",
    "predist": "npm run build:frontend && npm run build:sidecar",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.spreamming.verttrade",
    "productName": "VertTrade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  }
}
